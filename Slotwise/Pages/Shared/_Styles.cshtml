<style>
    :root {
        --bg: #0b1220;
        --panel: #1e293b;
        --panel-2: #16213a;
        --border: #334155;
        --text: #e2e8f0;
        --muted: #94a3b8;
        --accent: #2dd4bf;
        --accent-ink: #04211c;
        --sky: #38bdf8;
        --danger: #f87171;
        --amber: #fbbf24;
        --ok: #34d399;
    }
    * { box-sizing: border-box; }
    body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.5;
    }
    a { color: var(--sky); }
    .container { max-width: 960px; margin: 0 auto; padding: 0 16px; }
    main.container { padding-top: 24px; padding-bottom: 48px; }

    .site-header { background: var(--panel-2); border-bottom: 1px solid var(--border); }
    .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 14px; padding-bottom: 14px; flex-wrap: wrap; }
    .brand { font-size: 1.35rem; font-weight: 700; color: var(--text); text-decoration: none; letter-spacing: .2px; }
    .brand .accent { color: var(--accent); }
    .brand-sub { color: var(--muted); font-weight: 400; font-size: 1rem; }
    .tagline { color: var(--muted); font-size: .95rem; }
    .tenant-line { color: var(--muted); font-size: .9rem; padding-bottom: 12px; }
    .tenant-line strong { color: var(--text); }
    .admin-nav { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
    .admin-nav a { color: var(--text); text-decoration: none; font-size: .95rem; }
    .admin-nav a:hover { color: var(--accent); }
    .logout-form { margin: 0; }
    .site-footer { border-top: 1px solid var(--border); color: var(--muted); font-size: .85rem; padding: 18px 0 28px; }

    h1 { font-size: 1.8rem; margin: 0 0 4px; }
    h2 { font-size: 1.25rem; margin: 0 0 14px; }
    h3 { font-size: 1.05rem; margin: 0 0 10px; }
    .subtitle { color: var(--muted); margin: 0 0 20px; }
    .muted { color: var(--muted); }
    .small { font-size: .85rem; }

    .card {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .btn {
        display: inline-block;
        background: var(--accent);
        color: var(--accent-ink);
        border: 1px solid var(--accent);
        border-radius: 8px;
        padding: 9px 18px;
        font-size: .95rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
    }
    .btn:hover { filter: brightness(1.08); }
    .btn.secondary { background: transparent; color: var(--text); border-color: var(--border); }
    .btn.danger { background: transparent; color: var(--danger); border-color: var(--danger); }
    .btn.small { padding: 4px 10px; font-size: .82rem; border-radius: 6px; }
    .btn:disabled { opacity: .5; cursor: default; }

    label { display: block; font-size: .88rem; color: var(--muted); margin-bottom: 6px; }
    input[type="text"], input[type="email"], input[type="password"], input[type="date"],
    input[type="time"], input[type="number"], select {
        width: 100%;
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 9px 10px;
        font-size: .95rem;
        color-scheme: dark;
    }
    input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--accent); }
    .field { margin-bottom: 16px; }
    .form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; }
    .inline-form { display: inline; margin: 0; }

    .slots { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
    .slot {
        display: inline-block;
        padding: 9px 14px;
        border: 1px solid var(--accent);
        border-radius: 999px;
        color: var(--accent);
        text-decoration: none;
        font-weight: 600;
        font-size: .92rem;
    }
    .slot:hover { background: var(--accent); color: var(--accent-ink); }

    table { width: 100%; border-collapse: collapse; font-size: .93rem; }
    th { text-align: left; color: var(--muted); font-weight: 600; padding: 8px 10px; border-bottom: 1px solid var(--border); white-space: nowrap; }
    td { padding: 9px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
    tr:last-child td { border-bottom: none; }
    .table-wrap { overflow-x: auto; }

    .badge {
        display: inline-block; padding: 2px 9px; border-radius: 999px;
        font-size: .78rem; font-weight: 600; border: 1px solid var(--border); white-space: nowrap;
    }
    .badge-confirmed { color: var(--accent); border-color: var(--accent); }
    .badge-cancelled { color: var(--danger); border-color: var(--danger); }
    .badge-completed { color: var(--sky); border-color: var(--sky); }
    .badge-noshow { color: var(--amber); border-color: var(--amber); }
    .badge-reminder { color: #0b1220; background: var(--amber); border-color: var(--amber); margin-left: 6px; }

    .alert { border-radius: 10px; padding: 12px 16px; margin-bottom: 20px; border: 1px solid; font-size: .95rem; }
    .alert-warn { background: rgba(251, 191, 36, .12); border-color: var(--amber); color: #fde68a; }
    .alert-error { background: rgba(248, 113, 113, .12); border-color: var(--danger); color: #fecaca; }
    .alert-success { background: rgba(52, 211, 153, .12); border-color: var(--ok); color: #a7f3d0; }

    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; margin-bottom: 20px; }
    .stat { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 16px 20px; }
    .stat .num { font-size: 1.9rem; font-weight: 700; color: var(--accent); line-height: 1.1; }
    .stat .lbl { color: var(--muted); font-size: .88rem; }

    .summary { display: grid; grid-template-columns: auto 1fr; gap: 6px 18px; margin: 0 0 18px; }
    .summary dt { color: var(--muted); }
    .summary dd { margin: 0; font-weight: 600; }
    .actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .check { font-size: 2rem; color: var(--ok); line-height: 1; }
</style>
